NODE_ENV=development
PORT=3333
# Banco LOCAL: substitua a senha e confira a porta (5432 ou a da sua instalação).
DATABASE_URL="postgresql://solarsystem_app:SUBSTITUA_PELA_SENHA@localhost:5432/solarsystem?schema=public"

# Obrigatório: gere uma chave aleatória com pelo menos 32 caracteres.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# Não reutilize chaves de exemplos nem publique seu .env.
JWT_SECRET=
# Em produção, informe a origem pública HTTPS exata, sem barra final.
WEB_ORIGIN=http://localhost:5173
# IPs exatos dos proxies reversos confiáveis. Deixe vazio para conexões diretas.
TRUSTED_PROXY_IPS=

JWT_EXPIRES_IN=28800

# Recuperação de senha por e-mail. Configure as duas variáveis para habilitar.
SMTP_URL=
PASSWORD_RESET_FROM=

# Primeiro administrador (usado só pelo comando db:seed)
SEED_ADMIN_EMAIL=admin@example.com
# Preencha uma senha própria, com no mínimo 8 caracteres, antes de executar o seed.
SEED_ADMIN_PASSWORD=

# Minutos entre coletas; 0 desativa. Com valor > 0 também coleta ao iniciar a API.
SYNC_INTERVAL_MIN=10
