generator client {
  provider = "prisma-client-js"
}

// Localidade do banco
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Perfis de acesso (empresa + clientes)
enum Role {
  ADMIN
  OPERATOR
  CLIENT
}

model Client {
  id        String   @id @default(uuid())
  name      String
  document  String?  @unique // CPF/CNPJ, opcional (?), mas sem repetição
  email     String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users  User[] // Um cliente pode ter vários usuários
  plants Plant[]

  @@map("clients")
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  passwordHash       String   @map("password_hash") // Não é a senha real
  role               Role     @default(OPERATOR)
  active             Boolean  @default(true)
  clientId           String?  @map("client_id") // só usuários clientes têm
  client             Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  acknowledgedAlerts Alert[] // alertas que este usuário reconheceu

  @@index([clientId])
  @@map("users")
}

// Plataformas de monitoramento suportadas (cada uma terá um adaptador)
enum ProviderType {
  DEMO
}

// Saúde de uma usina
enum HealthStatus {
  ONLINE
  WARNING
  FAULT
  OFFLINE
  UNKNOWN
}

enum PlantOrigin {
  MANUAL
  IMPORTED
}

enum PlantLinkState {
  ACTIVE
  DETACHED
}

// Uma conta numa plataforma (ex.: o login da empresa no portal do fabricante)
model Integration {
  id          String       @id @default(uuid())
  provider    ProviderType
  name        String
  credentials Json         @default("{}") // dados de acesso à plataforma; nunca saem pela API
  enabled     Boolean      @default(true)
  archivedAt  DateTime?    @map("archived_at")
  revision    Int          @default(0)
  lastSyncAt  DateTime?    @map("last_sync_at")
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  alerts      Alert[]

  plants        Plant[]
  externalLinks PlantExternalLink[]
  discoveries   PlantDiscovery[]
  inverters     Inverter[]

  @@map("integrations")
}

// Uma usina, como a plataforma a descreve + o vínculo com o nosso cliente
enum InstallationType {
  GROUND
  ROOFTOP
  HYBRID
  CARPORT
  FLOATING
  OTHER
}

model Plant {
  id                 String            @id @default(uuid())
  // Projeção de compatibilidade. A identidade remota pertence ao vínculo.
  // Triggers diferidos garantem coerência com o vínculo ACTIVE no commit.
  integrationId      String?           @map("integration_id")
  externalId         String?           @map("external_id")
  origin             PlantOrigin       @default(IMPORTED)
  manualOverrides    Json              @default("{}") @map("manual_overrides")
  revision           Int               @default(0)
  name               String
  clientId           String?           @map("client_id")
  capacityKwp        Float?            @map("capacity_kwp")
  city               String?
  state              String?
  installationType   InstallationType? @map("installation_type")
  nominalPowerKw     Float?            @map("nominal_power_kw")
  moduleTiltDegrees  Float?            @map("module_tilt_degrees")
  operationStartDate DateTime?         @map("operation_start_date") @db.Date
  postalCode         String?           @map("postal_code")
  street             String?
  addressNumber      String?           @map("address_number")
  addressComplement  String?           @map("address_complement")
  latitude           Float?
  longitude          Float?
  technicalNotes     String?           @map("technical_notes")
  status             HealthStatus      @default(UNKNOWN)
  currentPowerKw     Float?            @map("current_power_kw")
  todayEnergyKwh     Float?            @map("today_energy_kwh")
  totalEnergyKwh     Float?            @map("total_energy_kwh")
  lastDataAt         DateTime?         @map("last_data_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  integration   Integration?        @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  client        Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  alerts        Alert[]
  externalLinks PlantExternalLink[]
  discoveries   PlantDiscovery[]
  auditEvents   PlantAuditEvent[]
  measurements  Measurement[]
  inverters     Inverter[]

  @@unique([integrationId, externalId]) // a mesma usina nunca entra duas vezes
  @@index([clientId])
  @@map("plants")
}

enum InverterOrigin {
  MANUAL
  IMPORTED
}

enum InverterStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  FAULT
  MAINTENANCE
}

model Inverter {
  id                  String         @id @default(uuid())
  plantId             String         @map("plant_id")
  manufacturer        String
  manufacturerKey     String         @map("manufacturer_key")
  model               String
  serialNumber        String         @map("serial_number")
  serialKey           String         @map("serial_key")
  status              InverterStatus @default(UNKNOWN)
  origin              InverterOrigin @default(MANUAL)
  integrationId       String?        @map("integration_id")
  externalId          String?        @map("external_id")
  lastCommunicationAt DateTime?      @map("last_communication_at")
  revision            Int            @default(0)
  archivedAt          DateTime?      @map("archived_at")
  archiveReason       String?        @map("archive_reason")
  archivedById        String?        @map("archived_by_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  plant               Plant          @relation(fields: [plantId], references: [id], onDelete: Restrict)
  integration         Integration?   @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  measurements        Measurement[]

  @@unique([id, plantId])
  @@unique([manufacturerKey, serialKey])
  @@unique([integrationId, externalId])
  @@index([plantId, archivedAt])
  @@map("inverters")
}

model PlantExternalLink {
  id             String         @id @default(uuid())
  plantId        String         @map("plant_id")
  integrationId  String         @map("integration_id")
  externalId     String         @map("external_id")
  state          PlantLinkState @default(ACTIVE)
  revision       Int            @default(0)
  linkedAt       DateTime       @default(now()) @map("linked_at")
  detachedAt     DateTime?      @map("detached_at")
  remoteMetadata Json           @map("remote_metadata")
  lastSample     Json?          @map("last_sample")
  observedAt     DateTime       @map("observed_at")
  plant          Plant          @relation(fields: [plantId], references: [id], onDelete: Restrict)
  integration    Integration    @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  measurements   Measurement[]

  @@unique([id, plantId])
  @@unique([integrationId, externalId])
  // Uma fonte ACTIVE por usina: índice parcial na migration SQL.
  @@index([plantId, state])
  @@map("plant_external_links")
}

enum MeasurementQuality {
  VALID
  PARTIAL
  INVALID
}

model Measurement {
  id                String             @id @default(uuid())
  plantId           String             @map("plant_id")
  inverterId        String?            @map("inverter_id")
  sourceLinkId      String             @map("source_link_id")
  sourceProvider    ProviderType       @map("source_provider")
  isSimulated       Boolean            @default(false) @map("is_simulated")
  measuredAt        DateTime           @map("measured_at") @db.Timestamptz(3)
  powerKw           Float?             @map("power_kw")
  totalEnergyKwh    Float?             @map("total_energy_kwh")
  periodEnergyKwh   Float?             @map("period_energy_kwh")
  periodStartAt     DateTime?          @map("period_start_at") @db.Timestamptz(3)
  operationalStatus HealthStatus?      @map("operational_status")
  quality           MeasurementQuality
  qualityReason     String?            @map("quality_reason")
  recordedAt        DateTime           @default(now()) @map("recorded_at") @db.Timestamptz(3)
  plant             Plant              @relation(fields: [plantId], references: [id], onDelete: Restrict)
  inverter          Inverter?          @relation(fields: [inverterId, plantId], references: [id, plantId], onDelete: Restrict, onUpdate: Restrict)
  sourceLink        PlantExternalLink  @relation(fields: [sourceLinkId, plantId], references: [id, plantId], onDelete: Restrict, onUpdate: Restrict)

  // Leituras da usina sem inverterId: unicidade adicional parcial na migration.
  @@unique([sourceLinkId, inverterId, measuredAt])
  @@index([plantId, measuredAt, id])
  @@index([inverterId, measuredAt])
  @@map("measurements")
}

model PlantDiscovery {
  id            String      @id @default(uuid())
  integrationId String      @map("integration_id")
  externalId    String      @map("external_id")
  snapshot      Json
  revision      Int         @default(0)
  observedAt    DateTime    @map("observed_at")
  resolvedAt    DateTime?   @map("resolved_at")
  plantId       String?     @map("plant_id")
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  plant         Plant?      @relation(fields: [plantId], references: [id], onDelete: Restrict)

  @@unique([integrationId, externalId])
  @@map("plant_discoveries")
}

model PlantAuditEvent {
  id        String   @id @default(uuid())
  plantId   String   @map("plant_id")
  actorId   String?  @map("actor_id")
  operation String
  details   Json
  createdAt DateTime @default(now()) @map("created_at")
  plant     Plant    @relation(fields: [plantId], references: [id], onDelete: Restrict)

  @@index([plantId, createdAt])
  @@map("plant_audit_events")
}

// O que aconteceu
enum AlertType {
  PLANT_OFFLINE // usina parou de enviar dados
  PLANT_FAULT // inversor reportou falha
  SYNC_FAILED // não conseguimos falar com a plataforma
}

// Quão grave é
enum AlertSeverity {
  WARNING
  CRITICAL
}

// Ciclo de vida: aberto -> reconhecido (alguém assumiu) -> resolvido (a condição sumiu)
enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id               String        @id @default(uuid())
  type             AlertType
  severity         AlertSeverity
  status           AlertStatus   @default(OPEN)
  message          String
  plantId          String?       @map("plant_id") // alertas de usina
  integrationId    String?       @map("integration_id") // alertas de integração
  acknowledgedById String?       @map("acknowledged_by_id")
  openedAt         DateTime      @default(now()) @map("opened_at")
  acknowledgedAt   DateTime?     @map("acknowledged_at")
  resolvedAt       DateTime?     @map("resolved_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: Restrict)
  integration    Integration? @relation(fields: [integrationId], references: [id], onDelete: Restrict)
  acknowledgedBy User?        @relation(fields: [acknowledgedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([plantId, type, status]) // acelera a pergunta "já existe alerta aberto disto?"
  @@map("alerts")
}
