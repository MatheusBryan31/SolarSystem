{
  "name": "solarsystem",
  "version": "0.1.0",
  "private": true,
  "description": "SolarSystem - monitoramento unificado de usinas fotovoltaicas",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:api": "npm run start:dev -w apps/api",
    "dev:painel": "npm run dev -w apps/painel",
    "dev": "concurrently --kill-others --names api,painel \"npm:dev:api\" \"npm:dev:painel\"",
    "build:api": "npm run build -w apps/api",
    "build:painel": "npm run build -w apps/painel",
    "build": "npm run build:api && npm run build:painel",
    "test:api": "npm test -w apps/api -- --runInBand",
    "test:e2e": "npm run test:e2e -w apps/api -- --runInBand",
    "test:web": "npm --prefix apps/web/tests test",
    "test:painel": "npm test -w apps/painel",
    "test:sql": "node scripts/test-sql.cjs",
    "test:ops": "node --test scripts/tests/*.test.cjs",
    "perf:check": "node scripts/check-bundle.cjs",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/painel",
    "lint:check": "npm run lint:check -w apps/api",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint:check",
    "format": "prettier --write .",
    "format: check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatheusBryan31/SolarSystem.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/MatheusBryan31/SolarSystem/issues"
  },
  "homepage": "https://github.com/MatheusBryan31/SolarSystem#readme",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.5"
  },
  "devDependencies": {
    "axe-core": "4.14.1",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1"
  }
}
